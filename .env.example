# Скопируйте в .env и замените значения. Файл .env в git не попадает.
POSTGRES_DB=familyquest
POSTGRES_USER=familyquest
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+asyncpg://familyquest:change-me@db:5432/familyquest
TEST_DATABASE_URL=postgresql+asyncpg://familyquest:change-me@db:5432/familyquest_test

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=["http://localhost:5173"]

# Пароли демо-взрослых для python -m app.seed
DEMO_MAMA_PASSWORD=change-me
DEMO_PAPA_PASSWORD=change-me
